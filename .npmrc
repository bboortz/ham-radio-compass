# Expo projects routinely have mismatched peer ranges between react-native,
# @types/react, and expo — especially when Dependabot bumps one dep without
# the companion upgrades. Enable legacy-peer-deps so `npm ci` can resolve
# the lockfile instead of exiting ERESOLVE. This matches what many Expo
# repos ship in their .npmrc and what Expo's own docs recommend.
legacy-peer-deps=true
