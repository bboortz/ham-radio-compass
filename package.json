{
  "name": "ham-radio-compass",
  "version": "1.1.0",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "check": "npm run lint && tsc --noEmit",
    "prepare": "husky install"
  },
  "dependencies": {
    "eas-cli": "^27.11.0",
    "expo": "~53.0.17",
    "expo-location": "~18.1.6",
    "expo-sensors": "~58.0.5",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.1",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@eslint/js": "^9.30.1",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^8.0.0",
    "prettier": "^3.10.1",
    "typescript": "~5.8.3"
  },
  "private": true,
  "overrides": {
    "form-data": "4.0.4",
    "shell-quote": "1.11.0",
    "tar": "7.5.19",
    "brace-expansion": "1.1.20"
  }
}
